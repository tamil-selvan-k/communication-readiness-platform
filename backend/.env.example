PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/comm_readiness

# File uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Shared secret for POST /internal/cache/invalidate on the Python AI service.
# Must match INTERNAL_API_KEY in ai-service/.env
INTERNAL_API_KEY=change-me
