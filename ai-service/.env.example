# LLM Provider selection
# Presets: groq | openai | together | anthropic | ollama | lmstudio | vllm | mock
LLM_PROVIDER=groq

# Generic API key — used by all cloud providers
LLM_API_KEY=your-api-key-here

# Generic model override — defaults to the provider preset if left blank
LLM_MODEL=openai/gpt-oss-120b
# Used in order when the main model hits its daily token limit (Groq limits are per model)
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Extra keys from other Groq accounts, comma-separated, used when the main key runs out
LLM_FALLBACK_API_KEYS=

# Explicit base URL — overrides preset (use for custom/local/self-hosted endpoints)
# Example (Ollama):    http://localhost:11434/v1
# Example (vLLM):      http://localhost:8000/v1
# Example (LM Studio): http://localhost:1234/v1
# Example (custom):    http://your-server.internal/v1
LLM_BASE_URL=

# Legacy Groq vars (still accepted for backward compat)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DEBUG=false

# Shared secret for POST /ai/config and POST /internal/cache/invalidate.
# Change to a strong random string in production.
INTERNAL_API_KEY=change-me

# ── Redis cache (Module 3) ────────────────────────────────────────────────────
# Leave empty (or remove) to disable caching; Module 3 falls back to PostgreSQL.
# Redis is a PERFORMANCE CACHE only — PostgreSQL is always the source of truth.
REDIS_URL=redis://localhost:6379/0

# Cache TTLs in seconds
# Performance + skill-gap caches are invalidated on ATTEMPT_COMPLETED.
# These TTLs are a safety net in case the invalidation call is missed.
MODULE3_PERFORMANCE_CACHE_TTL=600
MODULE3_SKILL_GAP_CACHE_TTL=600
# Knowledge docs change rarely — long TTL is appropriate.
MODULE3_KNOWLEDGE_CACHE_TTL=3600
