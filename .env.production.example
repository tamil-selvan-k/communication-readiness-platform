# ─────────────────────────────────────────────────────────────────────────────
# Production configuration — store these keys in AWS Secrets Manager, secret "pcp"
# (key/value pairs). The deploy workflow writes them to /opt/pcp/.env.production.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public address ───────────────────────────────────────────────────────────
# Host name Caddy serves with automatic HTTPS (Let's Encrypt). Its DNS A record must
# point at the EC2 public IP. Without a domain use <ip-with-dashes>.sslip.io,
# e.g. 13-233-10-20.sslip.io. The microphone only works over HTTPS.
SITE_ADDRESS=pcp.example.com
# Browser origin(s) allowed by CORS — comma-separated, no trailing slash
CORS_ORIGIN=https://pcp.example.com
# Used in e-mail links (invites, password resets)
APP_URL=https://pcp.example.com

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Proxy hops in front of the backend (caddy + nginx) — needed for per-client login throttling
TRUST_PROXY=2
# At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Shared secret between backend and AI service (compose passes it to both):  openssl rand -hex 24
AI_INTERNAL_KEY=
MAX_QUESTIONS_PER_SESSION=10
# true = also load the demo accounts (published password Password123!) — demos only
SEED_DEMO_DATA=false

# ── Database (PostgreSQL 16 with the pgvector extension) ─────────────────────
# Supabase / RDS / Neon URLs get SSL automatically. PostgreSQL installed on the EC2
# host itself: use host.docker.internal as the host name.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/comm_readiness
# Optional: run PostgreSQL in Docker on the same server instead
#   COMPOSE_PROFILES=local-db
#   POSTGRES_PASSWORD=<openssl rand -hex 16>
#   DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/comm_readiness

# ── Redis (runs in compose; REDIS_URL is derived from this password) ─────────
# Letters, digits, - and _ only:  openssl rand -hex 24
REDIS_PASSWORD=

# ── AI service (LLM) ─────────────────────────────────────────────────────────
# Provider presets: groq | openai | together | anthropic | ollama | lmstudio | vllm
# Any other OpenAI-compatible API: LLM_PROVIDER=openai plus LLM_BASE_URL.
# Without a working key the AI service silently falls back to canned mock questions.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=
# Optional, same provider only: models tried in order when the main model hits its
# daily limit (e.g. for Groq: openai/gpt-oss-20b). Leave empty for other providers.
LLM_FALLBACK_MODELS=
# Optional extra API keys for the same provider (comma-separated, other accounts)
LLM_FALLBACK_API_KEYS=

# ── Optional ─────────────────────────────────────────────────────────────────
# Server-side speech-to-text; without it the browser's speech recognition is used (Chrome/Edge)
DEEPGRAM_API_KEY=
# Without SMTP, admins see a temporary password when they create users
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
