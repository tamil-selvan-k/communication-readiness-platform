# ─────────────────────────────────────────────────────────────────────────────
# Frontend — Vite / React  (copy to .env and fill in real values)
# Only variables prefixed VITE_ reach the browser bundle — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend origin. Leave blank when the API is served from the same origin:
#   - local dev: the Vite proxy forwards /api to http://localhost:5000
#   - Docker / EC2: nginx in the frontend image forwards /api to the backend
# Set only when the API lives on another origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Optional override for the live-interview WebSocket endpoint.
# Default: derived from VITE_API_BASE_URL (or the page origin) + /api/interview/ws
VITE_INTERVIEW_WS_URL=
