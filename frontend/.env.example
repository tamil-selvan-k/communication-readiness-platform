# ─────────────────────────────────────────────────────────────────────────────
# Frontend — Vite / React  (copy to .env and fill in real values)
# All variables MUST be prefixed VITE_ to be exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL for the Node.js backend.
# Dev default: leave blank — Vite proxy rewrites /api → http://localhost:5000.
# Production: set to the full backend origin, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=
BACKEND_URL=http://localhost:5000

# ── OpenAI Whisper (optional) ─────────────────────────────────────────────────
# If set, the interview room uses Whisper for higher-accuracy transcription
# instead of the browser's built-in Web Speech API.
# Leave blank to use browser STT (default — no key needed).
VITE_OPENAI_API_KEY=

